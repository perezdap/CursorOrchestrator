{
  "name": "cursor-orchestrator",
  "version": "0.1.0",
  "description": "Windows-first, Cursor SDK-based agent orchestration framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "orchestrator": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "validate": "tsx src/cli.ts validate",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cursor",
    "sdk",
    "orchestration",
    "agent",
    "workflow"
  ],
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.18",
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "files": [
    "dist",
    "skills",
    "src/examples"
  ]
}
